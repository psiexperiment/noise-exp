'''
Lets the exposure run without a psivideo server.

The paradigm requires `psivideo.plugin.PSIVideo`, whose sink connects to the
server when the plugins start (`plugins_started`, at the default weight).
This swaps the sink's client for `FakeVideoClient` just before that.
'''
from enaml.workbench.api import Extension
from enaml.workbench.core.api import Command

from psi.controller.api import ExperimentAction
from psi.core.enaml.api import ExperimentManifest

from fake_video import FakeVideoClient


def use_fake_client(event):
    data = event.workbench.get_plugin('psi.data')
    data.find_sink('psivideo').client = FakeVideoClient()


enamldef NoVideoManifest(ExperimentManifest): manifest:

    id = 'noise_exp_test_no_video'

    Extension:
        id = manifest.id + '.commands'
        point = 'enaml.workbench.core.commands'

        Command:
            id = manifest.id + '.use_fake_client'
            handler = use_fake_client

    Extension:
        id = manifest.id + '.actions'
        point = 'psi.controller.actions'

        ExperimentAction:
            event = 'plugins_started'
            command = manifest.id + '.use_fake_client'
            # Before psivideo's start_client (weight 50).
            weight = 0
