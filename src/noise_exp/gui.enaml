import logging
log = logging.getLogger(__name__)

import os
from pathlib import Path
import subprocess

from atom.api import Atom, Bool, ContainerList, Enum, List, Str, Typed
from enaml.core.api import Conditional, Looper
from enaml.layout.api import align, hbox, spacer, vbox
from enaml.stdlib.message_box import critical
from enaml.widgets.api import (
    Action, ActionGroup, CheckBox, Container, Dialog, Field, HGroup, Label,
    MainWindow, Menu, MenuBar, ObjectCombo, PushButton
)

from psi import get_config, save_config
from psi.application import list_preferences

from .branding import load_app_icon
from .video import PSIVideoMonitor

from cftscal.api import (
    list_measurement_microphone_connections, list_speaker_connections,
    resolve_io
)
from cftscal.plugins.settings import (
    InputSettings, MicrophoneCalibrationReference, OutputSettings,
    SpeakerCalibrationReference
)
from cftscal.plugins.widgets import SensorView

#: Id of the paradigm's video plugin (`noise_exp.paradigms.VIDEO_PLUGIN`),
#: repeated rather than imported: importing the paradigms registers them.
VIDEO_PLUGIN = 'psivideo'

DATA_ROOT = Path(get_config('PSI_DATA_ROOT'))


def get_max_animals():
    '''
    Number of animals that can be exposed at once, i.e. the number of fields
    `CohortDialog` offers.

    Resolved on each call rather than at import so that a rig with a
    differently-sized cage only has to set NOISE_EXP_MAX_ANIMALS, in the
    configuration file or the environment.
    '''
    try:
        max_animals = get_config('NOISE_EXP_MAX_ANIMALS')
    except ValueError:
        # An environment variable that is not an integer at all; report it
        # the same way as one that is an unusable integer.
        max_animals = 0
    if max_animals < 1:
        # `repr` rather than the `!r` conversion: enaml's parser does not
        # support conversions in f-strings (format specs are fine).
        value = os.environ.get('NOISE_EXP_MAX_ANIMALS', max_animals)
        raise ValueError('NOISE_EXP_MAX_ANIMALS must be a positive integer, '
                         f'not {repr(value)}.')
    return max_animals


class Animal(Atom):
    '''
    One animal in the cohort.

    An Atom rather than a plain string so that the fields in `CohortDialog`
    can two-way bind to an individual entry.
    '''
    id = Str()


def make_animals(ids, max_animals=None):
    '''
    One `Animal` per field in `CohortDialog`, padded out to `max_animals`.

    The dialog shows a fixed set of fields, so the list is always
    `max_animals` long; a blank entry means that slot is empty.
    '''
    if max_animals is None:
        max_animals = get_max_animals()
    ids = list(ids)[:max_animals]
    blanks = [Animal() for _ in range(max_animals - len(ids))]
    return [Animal(id=i) for i in ids] + blanks


def select_connection(available, attr, name):
    '''
    The entry in `available` whose `attr` is `name`, else the first entry
    (e.g., the saved connection is not in this IO manifest), or None if there
    are none.
    '''
    for item in available:
        if getattr(item, attr) == name:
            return item
    return available[0] if available else None


def restore_calibration(reference, config, old_key, old_type):
    '''
    Restore the calibration picked for a connection from its saved settings.

    Settings saved before there was a choice of calibration type have only
    the name of the calibration (under `old_key`, of type `old_type`) and,
    for the microphone, its gain.
    '''
    try:
        if 'calibration' in config:
            reference.set_persistence(dict(config['calibration']))
            return
        if config.get(old_key):
            reference.switch_type(old_type)
            reference.name = config[old_key]
        if 'gain' in config:
            reference.gain = config['gain']
    except Exception as e:
        # E.g., a calibration type this cftscal no longer offers. The
        # defaults are kept, and the launcher asks for a calibration.
        log.warning('Could not restore the saved calibration %r: %s',
                    dict(config), e)


class Settings(Atom):

    logging_level = Enum('trace', 'debug', 'info', 'warning', 'error')('info')
    experimenter = Str()
    note = Str()
    preference = Str()

    #: Record video of the exposure, which needs psivideo running.
    record_video = Bool(True)

    #: Every measurement microphone input and speaker output in the IO
    #: manifest, each with the calibration picked for it (cftscal's
    #: references, as in the abts and cfts launchers: a calibration on file,
    #: or a nominal sensitivity, or unity for the microphone).
    available_inputs = List(InputSettings)
    available_outputs = List(OutputSettings)

    #: The selected input and output. None if the IO manifest has none.
    microphone = Typed(InputSettings)
    speaker = Typed(OutputSettings)

    #: IDs of the animals being exposed, entered via `CohortDialog`. A
    #: ContainerList so that mutating it in place notifies as well.
    animals = ContainerList(Str())

    #: Derived from `animals`; never set directly.
    cohort = Str()

    def _observe_animals(self, event):
        # The cohort is simply the animal IDs, space-delimited, which is how it
        # gets embedded in the filename.
        self.cohort = ' '.join(self.animals)

    def set_animals(self, animals):
        '''
        Set the cohort from the entries in `CohortDialog`.

        A blank field means that slot in the cage was empty, so it is dropped
        rather than becoming an animal with no ID.
        '''
        ids = [a.id.strip() for a in animals]
        self.animals = [i for i in ids if i]

    def __init__(self, *args, **kw):
        super().__init__(*args, **kw)
        self.load_config()

    def _default_available_inputs(self):
        return [
            InputSettings(
                input_name=name, input_label=label,
                # A measurement microphone by default; also a generic one,
                # unity or a nominal sensitivity.
                sensor=MicrophoneCalibrationReference(device_type='Meas. Mic.'))
            for label, name in list_measurement_microphone_connections().items()
        ]

    def _default_available_outputs(self):
        return [
            OutputSettings(
                output_name=name, output_label=label,
                # A calibrated speaker, or a nominal sensitivity.
                generator=SpeakerCalibrationReference())
            for label, name in list_speaker_connections().items()
        ]

    def check_ready(self):
        '''
        Raise ValueError, saying what is missing, unless a microphone and a
        speaker, each with a calibration, have been picked.
        '''
        for kind, selected, reference in (
                ('measurement microphone', self.microphone,
                 self.microphone and self.microphone.sensor),
                ('speaker', self.speaker,
                 self.speaker and self.speaker.generator)):
            if selected is None:
                raise ValueError(f'The IO manifest has no {kind}.')
            if not reference.is_configured():
                raise ValueError(f'Pick a calibration for the {kind}.')

    def build_command(self, save=True):
        '''
        The `psi` command that runs the exposure, and the environment to run
        it in.
        '''
        self.check_ready()
        env = {}
        env.update(self.microphone.get_env_vars(env_prefix='CFTSCAL_MICROPHONE'))
        env.update(self.speaker.get_env_vars(env_prefix='CFTSCAL_SPEAKER'))

        filename = f'{{date_time}} {self.experimenter} {self.cohort} {self.note} noise_exposure'
        filename = ' '.join(filename.split())
        args = ['psi', 'noise_exp.paradigms.noise_exposure']
        if save:
            args.append(str(DATA_ROOT / filename))
        if self.preference:
            args.extend(['--preferences', self.preference])
        args.extend([
            '--debug-level-console', self.logging_level.upper(),
        ])
        if self.record_video:
            args.extend(['--plugins', VIDEO_PLUGIN])
        # The manifest the speaker and microphone choices were filled from,
        # so the exposure runs on the hardware they were picked on.
        manifest, io_env = resolve_io()
        args.extend(['--io', manifest])
        env.update(io_env)
        return args, env

    def run_experiment(self, save=True):
        args, env = self.build_command(save)
        print(env)
        print(' '.join(args))
        subprocess.check_output(args, env=dict(os.environ, **env))

    def save_config(self):
        '''
        Save the current selections as this machine's defaults.

        Writes to the psi configuration file rather than a default.json of
        its own: one file per launcher meant the same kind of setting
        lived in several places, each with its own precedence relative to
        the environment.
        '''
        microphone = {}
        if self.microphone is not None:
            microphone = {
                'name': self.microphone.input_name,
                'calibration': self.microphone.sensor.get_persistence(),
            }
        speaker = {}
        if self.speaker is not None:
            speaker = {
                'name': self.speaker.output_name,
                'calibration': self.speaker.generator.get_persistence(),
            }
        save_config({
            'NOISE_EXP_LOGGING_LEVEL': self.logging_level,
            'NOISE_EXP_PREFERENCE': self.preference,
            'NOISE_EXP_RECORD_VIDEO': self.record_video,
            'NOISE_EXP_MICROPHONE': microphone,
            'NOISE_EXP_SPEAKER': speaker,
        })

    def load_config(self):
        self.logging_level = get_config('NOISE_EXP_LOGGING_LEVEL')
        self.preference = get_config('NOISE_EXP_PREFERENCE')
        self.record_video = get_config('NOISE_EXP_RECORD_VIDEO')

        config = get_config('NOISE_EXP_MICROPHONE')
        self.microphone = select_connection(self.available_inputs,
                                            'input_name', config.get('name'))
        if self.microphone is not None:
            restore_calibration(self.microphone.sensor, config,
                                'microphone', 'Meas. Mic.')

        config = get_config('NOISE_EXP_SPEAKER')
        self.speaker = select_connection(self.available_outputs,
                                         'output_name', config.get('name'))
        if self.speaker is not None:
            restore_calibration(self.speaker.generator, config,
                                'speaker', 'Speaker')


enamldef CohortDialog(Dialog): dialog:
    '''
    Collects the IDs of the animals in the cohort, one field per animal.

    There is one field per slot in the exposure cage (see `get_max_animals`)
    rather than a list that grows on demand, since the number of animals that
    can be exposed at once is fixed by the hardware. A blank field means that
    slot is empty.

    Edits its own copy of the list so that cancelling leaves the launcher's
    cohort untouched. The caller builds `animals` with `make_animals` and
    reads the IDs back out of it if `exec_` returns True.
    '''
    title = 'Cohort'

    #: Set explicitly: the dialog has no parent, so it does not inherit the
    #: main window's icon.
    icon = load_app_icon()

    #: One `Animal` per field, blanks included.
    attr animals = make_animals([])

    Container:

        Label:
            text = 'Leave a field blank if that slot is empty.'

        Looper:
            iterable << dialog.animals
            HGroup:
                padding = 0
                align_widths = False
                Label:
                    text = f'{loop_index + 1}'
                Field:
                    text := loop_item.id
                    placeholder = 'Animal ID'

        HGroup:
            padding = 0
            leading_spacer = spacer(0)
            PushButton:
                text = 'Cancel'
                clicked ::
                    dialog.reject()
            PushButton:
                text = 'OK'
                default = True
                clicked ::
                    dialog.accept()


enamldef Main(MainWindow):

    title = 'Noise Exposure'
    icon = load_app_icon()
    initial_size = (400, 300)

    attr settings = Settings()

    #: The exposure records video and will not start without psivideo, so
    #: both run buttons wait for it.
    attr video = PSIVideoMonitor()

    initialized ::
        video.start()

    closed ::
        video.stop()

    func launch_psivideo():
        try:
            video.launch()
        except Exception as e:
            log.exception(e)
            critical(self, 'Error starting psivideo', str(e))

    func start_experiment(save):
        '''
        Run the exposure, reporting any failure in a dialog.

        Errors raised in an enaml handler only reach sys.excepthook, which
        logs them to the console, where the user running the launcher will
        rarely be looking. Errors the exposure subprocess hits while starting
        up are reported by the subprocess itself (`launch_experiment` shows
        its own dialog and exits cleanly), so a non-zero exit status here
        means it died some other way.
        '''
        try:
            settings.run_experiment(save=save)
        except subprocess.CalledProcessError as e:
            log.exception(e)
            critical(self, 'Experiment failed',
                     f'The experiment exited with status {e.returncode}. '
                     'See the console for details.')
        except Exception as e:
            log.exception(e)
            critical(self, 'Error starting experiment', str(e))
        preferences.items = [str(p) for p in list_preferences('noise_exposure')]

    MenuBar:
        Menu:
            title = '&File'
            Action:
                text = 'Set Defaults\tCtrl+D'
                triggered ::
                    settings.save_config()
        Menu:
            title = '&Debug'
            Menu:
                title = 'Logging Level'
                ActionGroup:
                    Looper:
                        iterable = settings.get_member('logging_level').items
                        Action:
                            checkable = True
                            text = loop_item
                            checked ::
                                settings.logging_level = loop_item
                            checked << settings.logging_level == loop_item

    Container:
        layout_constraints => ():
            # Pull out alternating label/field entries
            labels = children[:-2:2]
            fields = children[1:-2:2]

            # Pull out buttons which are the last two children
            buttons = children[-2:]

            # Ensure each field is aligned with the label
            h_constraints = [hbox(l, f) for l, f in zip(labels, fields)]

            constraints = [
                # Stack the fields above the buttons, make the buttons appear
                # on the right hand side at the bottom.
                vbox(*h_constraints, hbox(spacer(0), *buttons)),

                # Ensure widths of labels and fields match
                align('right', *labels),
            ]
            for row in zip(labels, fields):
                constraints.append(align('v_center', *row))

            # Line up the connection lists, and the calibration type lists
            # that follow them (each SensorView's first widget).
            constraints.append(align('width', mic_select, speaker_select))
            views = [c for g in (mic_group, speaker_group)
                     for c in g.children if isinstance(c, SensorView)]
            type_combos = [v.visible_widgets()[0] for v in views
                           if v.visible_widgets()]
            if len(type_combos) > 1:
                constraints.append(align('left', *type_combos))
                constraints.append(align('width', *type_combos))
            return constraints

        Label:
            text = 'Microphone'

        HGroup: mic_group:
            padding = 0
            align_widths = False
            share_layout = True
            ObjectCombo: mic_select:
                items = settings.available_inputs
                selected := settings.microphone
                to_string = lambda x: x.input_label
            Conditional:
                condition << settings.microphone is not None
                # Calibration type (a measurement or generic microphone on
                # file, unity or a nominal sensitivity), the calibration,
                # and the gain.
                SensorView:
                    sensor << settings.microphone.sensor
                    show_label = False
            Conditional:
                condition << settings.microphone is None
                Label:
                    text = 'The IO manifest has no measurement microphone'

        Label:
            text = 'Speaker'

        HGroup: speaker_group:
            padding = 0
            align_widths = False
            share_layout = True
            ObjectCombo: speaker_select:
                items = settings.available_outputs
                selected := settings.speaker
                to_string = lambda x: x.output_label
            Conditional:
                condition << settings.speaker is not None
                # A speaker calibration on file, or a nominal sensitivity.
                SensorView:
                    sensor << settings.speaker.generator
                    show_label = False
            Conditional:
                condition << settings.speaker is None
                Label:
                    text = 'The IO manifest has no speaker'

        Label:
            text = 'Cohort'
        PushButton: cohort_button:
            name = 'cohort_button'
            # A button rather than a Field: the cohort is built from the
            # animal IDs entered in CohortDialog rather than typed in
            # directly, and a button is the only widget enaml offers that is
            # both non-editable and clickable.
            text << settings.cohort or 'Click to add animals'
            tool_tip = 'Click to edit the list of animals in this cohort'
            clicked ::
                dialog = CohortDialog(animals=make_animals(settings.animals))
                if dialog.exec_():
                    settings.set_animals(dialog.animals)
        Label:
            text = 'Experimenter'
        Field:
            text := settings.experimenter
        Label:
            text = 'Note'
        Field:
            text := settings.note
        Label:
            text = 'Settings'
        ObjectCombo: preferences:
            items = [str(p) for p in list_preferences('noise_exposure')]
            selected := settings.preference
            to_string = lambda x: Path(x).stem
        Label:
            text = 'Video'
        HGroup:
            padding = 0
            align_widths = False
            CheckBox:
                text = 'Record'
                checked := settings.record_video
                tool_tip = 'Record video of the exposure with psivideo'
            Label:
                text << 'psivideo is running' if video.running else \
                    'Starting psivideo...' if video.launching else \
                    'psivideo is not running'
                enabled << settings.record_video
            PushButton:
                text = 'Open psivideo'
                enabled << settings.record_video and \
                    not (video.running or video.launching)
                clicked ::
                    launch_psivideo()
        PushButton: dry_run:
            text = 'Dry run (do not save)'
            # Recording video needs psivideo running first.
            enabled << video.running or not settings.record_video
            tool_tip << '' if video.running or not settings.record_video \
                else 'Open psivideo (or untick Record) before starting the ' \
                'experiment'
            clicked ::
                start_experiment(False)
        PushButton: start:
            text = 'Start (save)'
            # The cohort ends up in the filename, so there is nothing
            # sensible to save under until at least one animal has been
            # entered. Dry runs do not save, so they only wait for psivideo.
            enabled << bool(settings.cohort) and \
                (video.running or not settings.record_video)
            tool_tip << \
                'Add at least one animal to the cohort before saving' \
                if not settings.cohort else \
                'Open psivideo (or untick Record) before starting the ' \
                'experiment' \
                if not (video.running or not settings.record_video) else ''
            clicked ::
                start_experiment(True)
