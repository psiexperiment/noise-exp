import os
from pathlib import Path
import subprocess

from atom.api import Atom, ContainerList, Dict, Enum, Str
from enaml.core.api import Looper
from enaml.layout.api import align, hbox, spacer, vbox
from enaml.widgets.api import (
    Action, ActionGroup, Container, Dialog, Field, HGroup, Label, MainWindow,
    Menu, MenuBar, ObjectCombo, PushButton
)

from psi import get_config, save_config
from psi.application import list_preferences

from .branding import load_app_icon

from cftscal.api import (
    list_measurement_microphone_connections, list_speaker_connections,
    measurement_microphone_manager, speaker_manager
)

DATA_ROOT = Path(get_config('PSI_DATA_ROOT'))


def get_max_animals():
    '''
    Number of animals that can be exposed at once, i.e. the number of fields
    `CohortDialog` offers.

    Resolved on each call rather than at import so that a rig with a
    differently-sized cage only has to set NOISE_EXP_MAX_ANIMALS, in the
    configuration file or the environment.
    '''
    try:
        max_animals = get_config('NOISE_EXP_MAX_ANIMALS')
    except ValueError:
        # An environment variable that is not an integer at all; report it
        # the same way as one that is an unusable integer.
        max_animals = 0
    if max_animals < 1:
        # `repr` rather than the `!r` conversion: enaml's parser does not
        # support conversions in f-strings (format specs are fine).
        value = os.environ.get('NOISE_EXP_MAX_ANIMALS', max_animals)
        raise ValueError('NOISE_EXP_MAX_ANIMALS must be a positive integer, '
                         f'not {repr(value)}.')
    return max_animals


class Animal(Atom):
    '''
    One animal in the cohort.

    An Atom rather than a plain string so that the fields in `CohortDialog`
    can two-way bind to an individual entry.
    '''
    id = Str()


def make_animals(ids, max_animals=None):
    '''
    One `Animal` per field in `CohortDialog`, padded out to `max_animals`.

    The dialog shows a fixed set of fields, so the list is always
    `max_animals` long; a blank entry means that slot is empty.
    '''
    if max_animals is None:
        max_animals = get_max_animals()
    ids = list(ids)[:max_animals]
    blanks = [Animal() for _ in range(max_animals - len(ids))]
    return [Animal(id=i) for i in ids] + blanks


class Settings(Atom):

    logging_level = Enum('trace', 'debug', 'info', 'warning', 'error')('info')
    experimenter = Str()
    note = Str()
    preference = Str()

    microphone_config = Dict()
    speaker_config = Dict()

    #: IDs of the animals being exposed, entered via `CohortDialog`. A
    #: ContainerList so that mutating it in place notifies as well.
    animals = ContainerList(Str())

    #: Derived from `animals`; never set directly.
    cohort = Str()

    def _observe_animals(self, event):
        # The cohort is simply the animal IDs, space-delimited, which is how it
        # gets embedded in the filename.
        self.cohort = ' '.join(self.animals)

    def set_animals(self, animals):
        '''
        Set the cohort from the entries in `CohortDialog`.

        A blank field means that slot in the cage was empty, so it is dropped
        rather than becoming an animal with no ID.
        '''
        ids = [a.id.strip() for a in animals]
        self.animals = [i for i in ids if i]

    def __init__(self, *args, **kw):
        super().__init__(*args, **kw)
        self.load_config()

    def run_experiment(self, save=True):
        input_name = self.microphone_config['name']
        input_device = self.microphone_config['microphone']
        mic_cal_ref = measurement_microphone_manager \
            .get_object(input_device) \
            .get_current_calibration().to_string()

        output_name = self.speaker_config['name']
        output_device = self.speaker_config['speaker']
        speaker_cal_ref = speaker_manager \
            .get_object(output_device) \
            .get_current_calibration().to_string()

        env = {
            'CFTSCAL_MICROPHONE': input_name,
            f'CFTSCAL_MICROPHONE_{input_name.upper()}_GAIN': str(self.microphone_config['gain']),
            f'CFTSCAL_MICROPHONE_{input_name.upper()}': mic_cal_ref,
            'CFTSCAL_SPEAKER': output_name,
            f'CFTSCAL_SPEAKER_{output_name.upper()}': speaker_cal_ref,
        }

        filename = f'{{date_time}} {self.experimenter} {self.cohort} {self.note} noise_exposure'
        filename = ' '.join(filename.split())
        args = ['psi', 'noise_exp.paradigms.noise_exposure']
        if save:
            args.append(str(DATA_ROOT / filename))
        if self.preference:
            args.extend(['--preferences', self.preference])
        args.extend([
            '--debug-level-console', self.logging_level.upper(),
        ])
        print(env)
        print(' '.join(args))
        subprocess.check_output(args, env=dict(os.environ, **env))

    def save_config(self):
        '''
        Save the current selections as this machine's defaults.

        Writes to the psi configuration file rather than a default.json of
        its own: one file per launcher meant the same kind of setting
        lived in several places, each with its own precedence relative to
        the environment.
        '''
        save_config({
            'NOISE_EXP_LOGGING_LEVEL': self.logging_level,
            'NOISE_EXP_PREFERENCE': self.preference,
            'NOISE_EXP_MICROPHONE': dict(self.microphone_config),
            'NOISE_EXP_SPEAKER': dict(self.speaker_config),
        })

    def load_config(self):
        self.logging_level = get_config('NOISE_EXP_LOGGING_LEVEL')
        self.preference = get_config('NOISE_EXP_PREFERENCE')
        self.microphone_config = dict(get_config('NOISE_EXP_MICROPHONE'))
        self.speaker_config = dict(get_config('NOISE_EXP_SPEAKER'))

        # Set reasonable defaults for microphone config
        self.microphone_config.setdefault('microphone', None)
        self.microphone_config.setdefault('gain', 0)
        mic_input_name = list(list_measurement_microphone_connections().values())[0]
        self.microphone_config.setdefault('name', mic_input_name)

        # Set reasonable defaults for speaker config
        self.speaker_config.setdefault('speaker', None)
        speaker_input_name = list(list_speaker_connections().values())[0]
        self.speaker_config.setdefault('name', speaker_input_name)


enamldef CohortDialog(Dialog): dialog:
    '''
    Collects the IDs of the animals in the cohort, one field per animal.

    There is one field per slot in the exposure cage (see `get_max_animals`)
    rather than a list that grows on demand, since the number of animals that
    can be exposed at once is fixed by the hardware. A blank field means that
    slot is empty.

    Edits its own copy of the list so that cancelling leaves the launcher's
    cohort untouched. The caller builds `animals` with `make_animals` and
    reads the IDs back out of it if `exec_` returns True.
    '''
    title = 'Cohort'

    #: Set explicitly: the dialog has no parent, so it does not inherit the
    #: main window's icon.
    icon = load_app_icon()

    #: One `Animal` per field, blanks included.
    attr animals = make_animals([])

    Container:

        Label:
            text = 'Leave a field blank if that slot is empty.'

        Looper:
            iterable << dialog.animals
            HGroup:
                padding = 0
                align_widths = False
                Label:
                    text = f'{loop_index + 1}'
                Field:
                    text := loop_item.id
                    placeholder = 'Animal ID'

        HGroup:
            padding = 0
            leading_spacer = spacer(0)
            PushButton:
                text = 'Cancel'
                clicked ::
                    dialog.reject()
            PushButton:
                text = 'OK'
                default = True
                clicked ::
                    dialog.accept()


enamldef Main(MainWindow):

    title = 'Noise Exposure'
    icon = load_app_icon()
    initial_size = (400, 300)

    attr settings = Settings()

    MenuBar:
        Menu:
            title = '&File'
            Action:
                text = 'Set Defaults\tCtrl+D'
                triggered ::
                    settings.save_config()
        Menu:
            title = '&Debug'
            Menu:
                title = 'Logging Level'
                ActionGroup:
                    Looper:
                        iterable = settings.get_member('logging_level').items
                        Action:
                            checkable = True
                            text = loop_item
                            checked ::
                                settings.logging_level = loop_item
                            checked << settings.logging_level == loop_item

    Container:
        layout_constraints => ():
            # Pull out alternating label/field entries
            labels = children[:-2:2]
            fields = children[1:-2:2]

            # Pull out buttons which are the last two children
            buttons = children[-2:]

            # Ensure each field is aligned with the label
            h_constraints = [hbox(l, f) for l, f in zip(labels, fields)]

            constraints = [
                # Stack the fields above the buttons, make the buttons appear
                # on the right hand side at the bottom.
                vbox(*h_constraints, hbox(spacer(0), *buttons)),

                # Ensure widths of labels and fields match
                align('right', *labels),
            ]
            for row in zip(labels, fields):
                constraints.append(align('v_center', *row))

            # Ensure mic/speaker fields are aligned
            constraints.extend([
                label_group.children[0].right == mic_group.children[0].right,
                label_group.children[1].right == mic_group.children[1].right,
                mic_group.children[0].right == speaker_group.children[0].right,
                mic_group.children[1].right == speaker_group.children[1].right,
            ])
            return constraints

        Label:
            text = ''

        HGroup: label_group:
            padding = 0
            align_widths = False
            share_layout = True
            Label:
                text = 'Connection'
            Label:
                text = 'Device'

        Label:
            text = 'Microphone'

        HGroup: mic_group:
            padding = 0
            align_widths = False
            share_layout = True
            ObjectCombo:
                attr connections = list_measurement_microphone_connections()
                attr connections_rev = {v: k for k, v in connections.items()}
                items = list(connections.values())
                selected ::
                    settings.microphone_config['name'] = selected
                selected << settings.microphone_config['name']
                to_string = lambda x: connections_rev[x]
            ObjectCombo:
                items = sorted(measurement_microphone_manager.list_names())
                selected << settings.microphone_config['microphone']
                selected ::
                    settings.microphone_config['microphone'] = selected
            ObjectCombo:
                items = [-20, -10, 0, 10, 20, 30, 40, 50]
                selected << settings.microphone_config['gain']
                selected ::
                    settings.microphone_config['gain'] = selected
            Label:
                text = 'dB gain'

        Label:
            text = 'Speaker'

        HGroup: speaker_group:
            padding = 0
            align_widths = False
            share_layout = True
            ObjectCombo:
                attr connections = list_speaker_connections()
                attr connections_rev = {v: k for k, v in connections.items()}
                items = list(connections.values())
                selected ::
                    settings.speaker_config['name'] = selected
                selected << settings.speaker_config['name']
                to_string = lambda x: connections_rev[x]
            ObjectCombo:
                items = sorted(speaker_manager.list_names())
                selected << settings.speaker_config['speaker']
                selected ::
                    settings.speaker_config['speaker'] = selected

        Label:
            text = 'Cohort'
        PushButton: cohort_button:
            name = 'cohort_button'
            # A button rather than a Field: the cohort is built from the
            # animal IDs entered in CohortDialog rather than typed in
            # directly, and a button is the only widget enaml offers that is
            # both non-editable and clickable.
            text << settings.cohort or 'Click to add animals'
            tool_tip = 'Click to edit the list of animals in this cohort'
            clicked ::
                dialog = CohortDialog(animals=make_animals(settings.animals))
                if dialog.exec_():
                    settings.set_animals(dialog.animals)
        Label:
            text = 'Experimenter'
        Field:
            text := settings.experimenter
        Label:
            text = 'Note'
        Field:
            text := settings.note
        Label:
            text = 'Settings'
        ObjectCombo: preferences:
            items = [str(p) for p in list_preferences('noise_exposure')]
            selected := settings.preference
            to_string = lambda x: Path(x).stem
        PushButton: dry_run:
            text = 'Dry run (do not save)'
            clicked ::
                settings.run_experiment(save=False)
                preferences.items = [str(p) for p in list_preferences('noise_exposure')]
        PushButton: start:
            text = 'Start (save)'
            # The cohort ends up in the filename, so there is nothing
            # sensible to save under until at least one animal has been
            # entered. Dry runs do not save, so they stay enabled.
            enabled << bool(settings.cohort)
            tool_tip << '' if settings.cohort else \
                'Add at least one animal to the cohort before saving'
            clicked ::
                settings.run_experiment(save=True)
                preferences.items = [str(p) for p in list_preferences('noise_exposure')]
