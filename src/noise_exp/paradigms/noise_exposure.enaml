import logging
log = logging.getLogger(__name__)

from functools import partial

import numpy as np

from enaml.application import deferred_call
from enaml.widgets.api import Label, ProgressBar
from enaml.workbench.api import Extension

from psiaudio.pipeline import coroutine

from psi.context.api import ContextGroup
from psi.controller.api import (
    Callback, ControllerManifest, Coroutine, EpochOutput, ExperimentAction,
    ExperimentCallback, IIRFilter, RMS, SPL
)
from psi.core.api import StatusItem
from psi.data.api import ChannelPlot, TimeContainer, ViewBox
from psi.data.sinks.api import BinaryStore
from psi.token.primitives import (
    BandlimitedNoise, BandlimitedFIRNoise, BroadbandNoise, Cos2Envelope,
    ShapedNoise
)

EXPERIMENT = __name__.rsplit('.', 1)[-1]
EXPOSURE_START_DELAY = 1


def configure_experiment(pb, fs, t0_end, **kwargs):
    pb.maximum = int(round(t0_end * fs))


def update_label(label, x):
    '''
    Show the running level in one of the status labels.

    The inputs that feed this run on the acquisition thread, but Qt widgets
    may only be touched from the GUI thread, so the update is marshalled
    across rather than applied in place.
    '''
    deferred_call(setattr, label, 'text', f'{x[-1]:.1f} dB SPL')


@coroutine
def update_progress(pb, target):
    '''
    Show how many samples have been recorded in the progress bar.

    The count is kept here, on the acquisition thread, and the bar is only
    ever set to it. Adding each block to `pb.value` instead lost blocks: the
    value is set on the GUI thread, so a block that arrived before the
    previous block's update had been applied read a stale value and
    overwrote that update.
    '''
    n = 0
    deferred_call(setattr, pb, 'value', n)
    while True:
        data = (yield)
        n += data.shape[-1]
        deferred_call(setattr, pb, 'value', n)
        target(data)


def steady_state(rise_time, duration):
    '''
    Start and end (s, experiment time) of the part of the exposure at full
    level: from the end of its onset ramp to the start of its offset ramp.
    '''
    start = EXPOSURE_START_DELAY + rise_time
    end = EXPOSURE_START_DELAY + duration - rise_time
    return start, end


@coroutine
def running_rms(start, end, target):
    '''
    Send `target` the RMS of the samples from `start` to `end` (s) received
    so far, each time a block brings more of them.

    Samples are placed by each block's `s0`, so the window is the same
    however the blocks fall. Nothing is sent before `start` or after `end`,
    so once the window has passed the last value stays.
    '''
    # Stores running sum of squares
    running_sum = 0
    running_n = 0
    while True:
        data = (yield)
        lb = max(round(start * data.fs) - data.s0, 0)
        ub = min(round(end * data.fs) - data.s0, data.n_time)
        if ub <= lb:
            continue
        data = data[..., lb:ub]
        running_sum += (data**2).sum(axis=-1)
        running_n += data.n_time
        target(np.sqrt(running_sum / running_n))


enamldef NoiseControllerManifest(ControllerManifest): manifest:

    Extension:
        id = EXPERIMENT + '.noise_exposure_stores'
        point = 'psi.data.sinks'

        BinaryStore:
            continuous_inputs = ['monitor_microphone', 'noise_level']

    Extension:
        id = EXPERIMENT + '.tokens'
        point = 'psi.token.tokens'

        Cos2Envelope: bandlimited_noise:
            name = 'bandlimited_noise_burst'
            label = 'Bandlimited noise'
            BandlimitedNoise:
                pass

        Cos2Envelope: broadband_noise:
            name = 'broadband_noise_burst'
            label = 'Broadband noise'
            BroadbandNoise:
                pass

        Cos2Envelope: shaped_noise:
            name = 'shaped_noise_burst'
            label = 'Shaped noise'
            ShapedNoise:
                pass

        Cos2Envelope: bandlimited_fir_noise:
            name = 'bandlimited_fir_noise_burst'
            label = 'FIR noise'
            values = {
                'start_time': 0,
            }
            BandlimitedFIRNoise:
                values = {
                    'polarity': 1,
                    'audiogram_weighting': None,
                    'correct_level': True,
                }

    Extension:
        id = EXPERIMENT + '.items'
        point = 'psi.context.items'

        ContextGroup:
            name = 'hardware_settings'
            label = 'Hardware'

    Extension:
        id = EXPERIMENT + '.io'
        point = 'psi.controller.io'

        EpochOutput: output:
            name = 'exposure'
            label = 'Exposure'
            target_name = 'speaker_output'
            token = bandlimited_fir_noise

        IIRFilter:
            source_name = 'monitor_microphone'
            btype = 'highpass'
            ftype = 'butter'
            N = 2
            f_highpass = 100
            name = 'microphone_filtered'

            IIRFilter:
                name = 'microphone_band_filtered'
                btype = 'bandpass'
                ftype = 'butter'
                f_lowpass = C.exposure_bandlimited_noise_fh / .95
                f_highpass = C.exposure_bandlimited_noise_fl * .95
                N = 4

                RMS:
                    name = 'Band RMS'
                    duration = 1
                    SPL:
                        name = 'band_noise_level'

                Coroutine:
                    coroutine = partial(running_rms, *steady_state(
                        C.exposure_bandlimited_fir_noise_burst_rise_time,
                        C.exposure_bandlimited_fir_noise_burst_duration))

                    SPL:
                        Callback:
                            function = partial(update_label, average_band_level)

            RMS:
                name = 'RMS'
                duration = 1
                SPL:
                    name = 'noise_level'

            # Beside the RMS, not inside it, so the average is of the signal
            # (like the band's): inside, it averaged the 1 s levels, leaving
            # out the last partial second and updating once a second.
            Coroutine:
                coroutine = partial(running_rms, *steady_state(
                    C.exposure_bandlimited_fir_noise_burst_rise_time,
                    C.exposure_bandlimited_fir_noise_burst_duration))

                SPL:
                    Callback:
                        function = partial(update_label, average_level)

        Coroutine:
            source_name = 'monitor_microphone'
            name = 'update_progress'
            args = (pb_experiment,)
            coroutine = update_progress

    Extension:
        id = EXPERIMENT + '.workspace'
        point = 'psi.experiment.status'

        StatusItem:
            label = 'Exposure status'
            trailing_spacer = False

            ProgressBar: pb_experiment:
                name = 'noise_progress'
                text_visible = True

        StatusItem:
            label = 'Average overall level (dB SPL)'

            Label: average_level:
                text = ''

        StatusItem:
            label = 'Average level in band (dB SPL)'

            Label: average_band_level:
                text = ''

    Extension:
        id = EXPERIMENT + '.actions'
        point = 'psi.controller.actions'
        rank = 100

        ExperimentAction:
            event = 'experiment_initialize'
            command = 'psi.context.initialize'
            kwargs = {'selector': None}

        ExperimentAction:
            event = 'context_initialized'
            command = 'exposure.prepare'

        ExperimentAction:
            event = 'experiment_start'
            command = 'exposure.start'
            kwargs = {'start': EXPOSURE_START_DELAY}

        ExperimentCallback:
            event = 'exposure_start'
            callback = configure_experiment
            kwargs = {'pb': pb_experiment, 'fs': output.fs}

        ExperimentAction:
            event = 'exposure_end'
            command = 'psi.controller.stop'

    Extension:
        id = EXPERIMENT + '.plots'
        point = 'psi.data.plots'

        TimeContainer:
            name = 'noise_level_container'
            label = 'Level'
            delay = 0
            span = 600

            ViewBox:
                label = 'Noise level (dB SPL)'
                save_limits = True
                y_min = 108
                y_max = 118

                ChannelPlot:
                    source_name = 'noise_level'
