import logging
log = logging.getLogger(__name__)

from functools import partial

import numpy as np

from enaml.application import deferred_call
from enaml.widgets.api import Label, ProgressBar
from enaml.workbench.api import Extension

from psiaudio.pipeline import coroutine

from psi.context.api import (
    ContextGroup, ContextRow, EnumParameter, Expression, Parameter
)
from psi.controller.api import (
    Callback, ControllerManifest, Coroutine, EpochOutput, ExperimentAction,
    ExperimentCallback, IIRFilter, RMS, SPL
)
from psi.core.api import StatusItem
from psi.data.api import ChannelPlot, TimeContainer, ViewBox
from psi.data.sinks.api import BinaryStore, TableStore
from psi.token.primitives import BandlimitedFIRNoise, Cos2Envelope

from noise_exp.level_control import LevelControl

EXPERIMENT = __name__.rsplit('.', 1)[-1]
EXPOSURE_START_DELAY = 1


def configure_experiment(pb, fs, t0_end, **kwargs):
    pb.maximum = int(round(t0_end * fs))


def update_label(label, x):
    '''
    Show the running level in one of the status labels.

    The inputs that feed this run on the acquisition thread, but Qt widgets
    may only be touched from the GUI thread, so the update is marshalled
    across rather than applied in place.
    '''
    deferred_call(setattr, label, 'text', f'{x[-1]:.1f} dB SPL')


@coroutine
def update_progress(pb, target):
    '''
    Show how many samples have been recorded in the progress bar.

    The count is kept here, on the acquisition thread, and the bar is only
    ever set to it. Adding each block to `pb.value` instead lost blocks: the
    value is set on the GUI thread, so a block that arrived before the
    previous block's update had been applied read a stale value and
    overwrote that update.
    '''
    n = 0
    deferred_call(setattr, pb, 'value', n)
    while True:
        data = (yield)
        n += data.shape[-1]
        deferred_call(setattr, pb, 'value', n)
        target(data)


def steady_state(rise_time, duration):
    '''
    Start and end (s, experiment time) of the part of the exposure at full
    level: from the end of its onset ramp to the start of its offset ramp.
    '''
    start = EXPOSURE_START_DELAY + rise_time
    end = EXPOSURE_START_DELAY + duration - rise_time
    return start, end


@coroutine
def running_rms(start, end, target):
    '''
    Send `target` the RMS of the samples from `start` to `end` (s) received
    so far, each time a block brings more of them.

    Samples are placed by each block's `s0`, so the window is the same
    however the blocks fall. Nothing is sent before `start` or after `end`,
    so once the window has passed the last value stays.
    '''
    # Stores running sum of squares
    running_sum = 0
    running_n = 0
    while True:
        data = (yield)
        lb = max(round(start * data.fs) - data.s0, 0)
        ub = min(round(end * data.fs) - data.s0, data.n_time)
        if ub <= lb:
            continue
        data = data[..., lb:ub]
        running_sum += (data**2).sum(axis=-1)
        running_n += data.n_time
        target(np.sqrt(running_sum / running_n))


#: Columns of the level control's log (`level_control.csv`), one row per
#: decision: when it was made (s), what it did, the median band level of the
#: window (dB SPL), and the gain it set (dB, empty if unchanged).
LEVEL_LOG_COLUMNS = ['time', 'action', 'level', 'target', 'trim', 'drift',
                     'gain', 'message']


def report_level_control(label, store, record, status):
    '''
    Show the level control's status, and log its decision, from the
    acquisition thread (see `update_label`).
    '''
    deferred_call(setattr, label, 'text', status)
    if record is not None:
        row = {c: record[c] for c in LEVEL_LOG_COLUMNS}
        if row['gain'] is None:
            row['gain'] = np.nan
        deferred_call(store.process_table, row)


enamldef NoiseControllerManifest(ControllerManifest): manifest:

    Extension:
        id = EXPERIMENT + '.noise_exposure_stores'
        point = 'psi.data.sinks'

        BinaryStore:
            continuous_inputs = ['monitor_microphone', 'noise_level']

        TableStore: level_store:
            name = 'level_control'

    # The exposure is always FIR noise (the output is not configurable). Its
    # blocks are named `burst` and `noise` so that the settings psi makes for
    # them (`exposure_burst_*`, `exposure_noise_*`) leave the exposure's
    # established setting names to the rows below, which drive them. Saved
    # preferences and analyses of earlier data use those names.
    Extension:
        id = EXPERIMENT + '.tokens'
        point = 'psi.token.tokens'

        Cos2Envelope: exposure_noise:
            name = 'burst'
            label = 'FIR noise'
            values = {
                'start_time': 0,
            }
            BandlimitedFIRNoise:
                name = 'noise'
                values = {
                    'polarity': 1,
                    'audiogram_weighting': None,
                }

    Extension:
        id = EXPERIMENT + '.items'
        point = 'psi.context.items'

        ContextGroup:
            name = 'hardware_settings'
            label = 'Hardware'

        # The exposure's settings, laid out as sentences. They have a group of
        # their own: the output's group (`exposure`) is left holding only the
        # token's settings, which the rows drive, so psi hides it. Defaults
        # are the token's.
        ContextGroup:
            name = 'exposure_settings'
            label = 'Exposure'

            ContextRow:
                name = 'exposure_band'
                fmt = ['Noise', fl, 'to', fh, 'Hz at', level, 'dB SPL']

                Parameter: fl:
                    name = 'exposure_bandlimited_noise_fl'
                    label = 'exposure highpass cutoff (Hz)'
                    default = 0.1e3
                    scope = 'experiment'

                Parameter: fh:
                    name = 'exposure_bandlimited_noise_fh'
                    label = 'exposure lowpass cutoff (Hz)'
                    default = 20e3
                    scope = 'experiment'

                Parameter: level:
                    name = 'exposure_bandlimited_noise_level'
                    label = 'exposure level (dB SPL)'
                    default = 60.0
                    scope = 'experiment'

            ContextRow:
                name = 'exposure_timing'
                fmt = ['Duration', duration, 's with', rise_time, 's ramp']

                Parameter: duration:
                    name = 'exposure_bandlimited_fir_noise_burst_duration'
                    label = 'exposure duration (s)'
                    default = 4.0
                    scope = 'experiment'
                    # Usually typed as an expression (e.g., 60 * 60 * 2).
                    field_width = 90

                Parameter: rise_time:
                    name = 'exposure_bandlimited_fir_noise_burst_rise_time'
                    label = 'exposure rise time (s)'
                    default = 1.0
                    scope = 'experiment'

            ContextRow:
                name = 'exposure_equalization'
                fmt = ['Equalize', equalize, 'with max eq. correction',
                       max_correction, 'dB']

                EnumParameter: equalize:
                    name = 'exposure_bandlimited_noise_equalize'
                    label = 'equalize exposure'
                    default = 'yes'
                    choices = {'yes': True, 'no': False}
                    scope = 'experiment'

                Parameter: max_correction:
                    name = 'exposure_bandlimited_noise_max_correction'
                    label = 'exposure max eq. correction (dB)'
                    default = 20
                    scope = 'experiment'

            ContextRow:
                name = 'exposure_noise'
                fmt = ['Random seed', seed, 'with legacy level scaling',
                       legacy_level]

                Parameter: seed:
                    name = 'exposure_bandlimited_noise_seed'
                    label = 'exposure random seed'
                    default = 1
                    scope = 'experiment'

                # See `BandlimitedFIRNoiseFactory` (psiaudio): 'yes' repeats an
                # exposure run before the noise's level was fixed.
                EnumParameter: legacy_level:
                    name = 'exposure_bandlimited_noise_legacy_level'
                    label = 'exposure legacy level scaling'
                    default = 'no'
                    choices = {'yes': True, 'no': False}
                    scope = 'experiment'

            # The feedback loop holding the level at target, measured in the
            # exposure band or overall (see `noise_exp.level_control`). Off
            # with legacy level scaling, which repeats an earlier,
            # uncontrolled exposure.
            ContextRow:
                name = 'exposure_level_control'
                fmt = ['Hold', measure, 'level at target', level_control,
                       'judging the median of every', control_window, 's']

                EnumParameter: measure:
                    name = 'exposure_level_control_measure'
                    label = 'exposure level control measure'
                    default = 'band'
                    choices = {'band': "'band'", 'overall': "'overall'"}
                    scope = 'experiment'

                EnumParameter: level_control:
                    name = 'exposure_level_control'
                    label = 'hold exposure level at target'
                    default = 'yes'
                    choices = {'yes': True, 'no': False}
                    scope = 'experiment'

                Parameter: control_window:
                    name = 'exposure_level_control_window'
                    label = 'exposure level control window (s)'
                    default = 10
                    scope = 'experiment'

            ContextRow:
                name = 'exposure_level_control_limits'
                fmt = ['Correct up to ±', max_trim, 'dB at the start, then ±',
                       max_drift, 'dB']

                Parameter: max_trim:
                    name = 'exposure_level_control_max_trim'
                    label = 'exposure level control max trim (dB)'
                    default = 6
                    scope = 'experiment'

                Parameter: max_drift:
                    name = 'exposure_level_control_max_drift'
                    label = 'exposure level control max drift (dB)'
                    default = 2
                    scope = 'experiment'

        Expression:
            parameter = 'exposure_burst_duration'
            expression = 'exposure_bandlimited_fir_noise_burst_duration'
        Expression:
            parameter = 'exposure_burst_rise_time'
            expression = 'exposure_bandlimited_fir_noise_burst_rise_time'
        Expression:
            parameter = 'exposure_noise_fl'
            expression = 'exposure_bandlimited_noise_fl'
        Expression:
            parameter = 'exposure_noise_fh'
            expression = 'exposure_bandlimited_noise_fh'
        Expression:
            parameter = 'exposure_noise_level'
            expression = 'exposure_bandlimited_noise_level'
        Expression:
            parameter = 'exposure_noise_equalize'
            expression = 'exposure_bandlimited_noise_equalize'
        Expression:
            parameter = 'exposure_noise_max_correction'
            expression = 'exposure_bandlimited_noise_max_correction'
        Expression:
            parameter = 'exposure_noise_seed'
            expression = 'exposure_bandlimited_noise_seed'
        Expression:
            parameter = 'exposure_noise_legacy_level'
            expression = 'exposure_bandlimited_noise_legacy_level'

    Extension:
        id = EXPERIMENT + '.io'
        point = 'psi.controller.io'

        EpochOutput: output:
            name = 'exposure'
            label = 'Exposure'
            target_name = 'speaker_output'
            token = exposure_noise
            # No token menu: the settings rows are the FIR noise's.
            configurable = False

        IIRFilter:
            source_name = 'monitor_microphone'
            btype = 'highpass'
            ftype = 'butter'
            N = 2
            f_highpass = 100
            name = 'microphone_filtered'

            IIRFilter:
                name = 'microphone_band_filtered'
                btype = 'bandpass'
                ftype = 'butter'
                f_lowpass = C.exposure_bandlimited_noise_fh / .95
                f_highpass = C.exposure_bandlimited_noise_fl * .95
                N = 4

                RMS:
                    name = 'Band RMS'
                    duration = 1
                    SPL:
                        name = 'band_noise_level'

                Coroutine:
                    coroutine = partial(running_rms, *steady_state(
                        C.exposure_bandlimited_fir_noise_burst_rise_time,
                        C.exposure_bandlimited_fir_noise_burst_duration))

                    SPL:
                        Callback:
                            function = partial(update_label, average_band_level)

                LevelControl:
                    name = 'level_control_band'
                    selected = C.exposure_level_control_measure == 'band'
                    exposure = output
                    enabled = (C.exposure_level_control and
                               not C.exposure_bandlimited_noise_legacy_level)
                    target_level = C.exposure_bandlimited_noise_level
                    window = C.exposure_level_control_window
                    max_trim = C.exposure_level_control_max_trim
                    max_drift = C.exposure_level_control_max_drift
                    start = steady_state(
                        C.exposure_bandlimited_fir_noise_burst_rise_time,
                        C.exposure_bandlimited_fir_noise_burst_duration)[0]
                    end = steady_state(
                        C.exposure_bandlimited_fir_noise_burst_rise_time,
                        C.exposure_bandlimited_fir_noise_burst_duration)[1]
                    report = partial(report_level_control, level_correction,
                                     level_store)

            RMS:
                name = 'RMS'
                duration = 1
                SPL:
                    name = 'noise_level'

            LevelControl:
                name = 'level_control_overall'
                selected = C.exposure_level_control_measure == 'overall'
                exposure = output
                enabled = (C.exposure_level_control and
                           not C.exposure_bandlimited_noise_legacy_level)
                target_level = C.exposure_bandlimited_noise_level
                window = C.exposure_level_control_window
                max_trim = C.exposure_level_control_max_trim
                max_drift = C.exposure_level_control_max_drift
                start = steady_state(
                    C.exposure_bandlimited_fir_noise_burst_rise_time,
                    C.exposure_bandlimited_fir_noise_burst_duration)[0]
                end = steady_state(
                    C.exposure_bandlimited_fir_noise_burst_rise_time,
                    C.exposure_bandlimited_fir_noise_burst_duration)[1]
                report = partial(report_level_control, level_correction,
                                 level_store)

            # Beside the RMS, not inside it, so the average is of the signal
            # (like the band's): inside, it averaged the 1 s levels, leaving
            # out the last partial second and updating once a second.
            Coroutine:
                coroutine = partial(running_rms, *steady_state(
                    C.exposure_bandlimited_fir_noise_burst_rise_time,
                    C.exposure_bandlimited_fir_noise_burst_duration))

                SPL:
                    Callback:
                        function = partial(update_label, average_level)

        Coroutine:
            source_name = 'monitor_microphone'
            name = 'update_progress'
            args = (pb_experiment,)
            coroutine = update_progress

    Extension:
        id = EXPERIMENT + '.workspace'
        point = 'psi.experiment.status'

        StatusItem:
            label = 'Exposure status'
            trailing_spacer = False

            ProgressBar: pb_experiment:
                name = 'noise_progress'
                text_visible = True

        StatusItem:
            label = 'Average overall level (dB SPL)'

            Label: average_level:
                text = ''

        StatusItem:
            label = 'Average level in band (dB SPL)'

            Label: average_band_level:
                text = ''

        StatusItem:
            label = 'Level correction'

            Label: level_correction:
                text = ''

    Extension:
        id = EXPERIMENT + '.actions'
        point = 'psi.controller.actions'
        rank = 100

        ExperimentAction:
            event = 'experiment_initialize'
            command = 'psi.context.initialize'
            kwargs = {'selector': None}

        ExperimentAction:
            event = 'context_initialized'
            command = 'exposure.prepare'

        ExperimentAction:
            event = 'experiment_start'
            command = 'exposure.start'
            kwargs = {'start': EXPOSURE_START_DELAY}

        ExperimentCallback:
            event = 'exposure_start'
            callback = configure_experiment
            kwargs = {'pb': pb_experiment, 'fs': output.fs}

        ExperimentAction:
            event = 'exposure_end'
            command = 'psi.controller.stop'

    Extension:
        id = EXPERIMENT + '.plots'
        point = 'psi.data.plots'

        TimeContainer:
            name = 'noise_level_container'
            label = 'Level'
            delay = 0
            span = 600

            ViewBox:
                label = 'Noise level (dB SPL)'
                save_limits = True
                y_min = 108
                y_max = 118

                ChannelPlot:
                    source_name = 'noise_level'
                    label = 'overall'
                    show_in_legend = True

                ChannelPlot:
                    source_name = 'band_noise_level'
                    label = 'in band'
                    pen_color = 'green'
                    show_in_legend = True
